class Solution {
public:
    vector<long long> prefix;
    vector<vector<long long>> dp; // int ki jagah long long

    long long solve(vector<int>& stoneValue, int l, int r){ // return long long
        if(l >= r) return 0;
        if(dp[l][r]!= -1) return dp[l][r];

        long long ans = 0; // long ki jagah long long
        long long total = prefix[r+1] - prefix[l]; // long ki jagah long long

        for(int i = l; i < r; i++){
            long long leftSum = prefix[i+1] - prefix[l];
            long long rightSum = total - leftSum;

            if(leftSum < rightSum){
                ans = max(ans, leftSum + solve(stoneValue, l, i));
            } else if(leftSum > rightSum){
                ans = max(ans, rightSum + solve(stoneValue, i+1, r));
            } else { // equal
                ans = max(ans, leftSum + max(solve(stoneValue, l, i), solve(stoneValue, i+1, r)));
            }
        }
        return dp[l][r] = ans;
    }

    int stoneGameV(vector<int>& stoneValue) {
        int n = stoneValue.size();
        prefix.resize(n+1, 0);
        dp.assign(n, vector<long long>(n, -1)); // -1 ke liye long long

        for(int i = 0; i < n; i++){
            prefix[i+1] = prefix[i] + stoneValue[i];
        }

        return solve(stoneValue, 0, n-1);
    }
};
