class Solution {
public:
    void nextPermutation(vector<int>& nums) {
        int n = nums.size();
        int i = n - 2;

        // Step 1: pehla dip dhoondo
        while(i >= 0 && nums[i] >= nums[i + 1]){
            i--;
        }

        // Step 2: agar dip mila to swap karo
        if(i >= 0){
            int j = n - 1;
            // Step 3: i se just bade wale ko dhoondo
            while(j >= 0 && nums[j] <= nums[i]){
                j--;
            }
            swap(nums[i], nums[j]);
        }

        // Step 4: i+1 se end tak reverse
        reverse(nums.begin() + i + 1, nums.end());
    }
};
