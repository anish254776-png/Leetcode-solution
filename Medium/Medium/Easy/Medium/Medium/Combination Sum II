class Solution {
public:
    vector<vector<int>> result;

    vector<vector<int>> combinationSum2(vector<int>& candidates, int target) {
        sort(candidates.begin(), candidates.end()); // imp for duplicate skip
        vector<int> curr;
        backtrack(candidates, target, 0, curr);
        return result;
    }

    void backtrack(vector<int>& candidates, int target, int start, vector<int>& curr){
        if(target == 0){
            result.push_back(curr);
            return;
        }

        for(int i = start; i < candidates.size(); i++){
            if(target - candidates[i] < 0) break; // pruning: aage sab bade hain

            // skip duplicates on same level
            if(i > start && candidates[i] == candidates[i-1]) continue;

            curr.push_back(candidates[i]);
            backtrack(candidates, target - candidates[i], i + 1, curr); // i+1: use once
            curr.pop_back();
        }
    }
};
