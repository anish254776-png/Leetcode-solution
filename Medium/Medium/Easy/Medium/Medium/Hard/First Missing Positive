class Solution {
public:
    int firstMissingPositive(vector<int>& nums) {
        int n = nums.size();

        // Step 1: Check if 1 is present
        bool hasOne = false;
        for(int i = 0; i < n; i++){
            if(nums[i] == 1) hasOne = true;
            if(nums[i] <= 0 || nums[i] > n) nums[i] = 1; // cleanup
        }
        if(!hasOne) return 1;

        // Step 2: Mark present numbers
        for(int i = 0; i < n; i++){
            int val = abs(nums[i]);
            if(val == n) val = 0; // handle n
            if(nums[val] > 0) nums[val] = -nums[val];
        }

        // Step 3: Find first positive
        for(int i = 1; i < n; i++){
            if(nums[i] > 0) return i;
        }
        if(nums[0] > 0) return n;

        return n + 1;
    }
};
