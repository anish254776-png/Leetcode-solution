class Solution {
public:
    vector<vector<int>> result;

    vector<vector<int>> combinationSum(vector<int>& candidates, int target) {
        vector<int> curr;
        backtrack(candidates, target, 0, curr);
        return result;
    }

    void backtrack(vector<int>& candidates, int target, int start, vector<int>& curr){
        if(target == 0){
            result.push_back(curr);
            return;
        }
        if(target < 0) return;

        for(int i = start; i < candidates.size(); i++){
            curr.push_back(candidates[i]); // choose
            backtrack(candidates, target - candidates[i], i, curr); // reuse allowed, so i not i+1
            curr.pop_back(); // backtrack
        }
    }
};
